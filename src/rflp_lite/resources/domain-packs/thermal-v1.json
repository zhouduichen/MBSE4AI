{
  "id": "thermal-v1",
  "version": 1,
  "display_name": "热与热管理工程",
  "description": "覆盖热源、传热、散热、热防护、环境控制和热安全的通用工程指导。",
  "stable_fields": [
    "id",
    "name",
    "description",
    "source",
    "confidence",
    "status",
    "assumptions",
    "relations"
  ],
  "extensions": {
    "pack_layer": "discipline",
    "reusable": true,
    "activation_terms": [
      "热管理",
      "散热",
      "传热",
      "温度",
      "热安全",
      "环境控制"
    ],
    "unknowns_are_first_class": true,
    "review_required_before_diagram": true
  },
  "core_overrides": [],
  "element_schemas": {
    "stakeholder": {
      "type": "object",
      "required": [
        "name",
        "category",
        "goals",
        "interactions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "scenario": {
      "type": "object",
      "required": [
        "name",
        "trigger",
        "expected_outcome"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcome": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "required": [
        "statement",
        "verification",
        "priority"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "must",
            "should",
            "could"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "responsibilities",
        "interfaces"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "required": [
        "name",
        "cause",
        "effect",
        "mitigations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "mitigations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "stakeholder_lenses": [

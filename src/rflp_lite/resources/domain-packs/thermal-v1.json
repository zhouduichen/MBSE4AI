  "coverage_rules": [
    {
      "id": "thermal-stakeholder-coverage",
      "source": "stakeholder_lenses",
      "priority": "high"
    },
    {
      "id": "thermal-lifecycle-coverage",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "load-ambient-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "heat-path-cooling-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "aging-and-monitoring",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "thermal-safety-evidence",
      "source": "stakeholder_lenses",
      "priority": "medium"
    }
  ],
  "prompt_fragments": {
    "stakeholders": "识别热负荷来源、系统负责人、热设计、操作维护、环境安全和制造供应角色。",
    "scenarios": "覆盖启动、稳态、峰值、环境变化、冷却受限、热点、超温、降级、应急降温和恢复。",
    "requirements": "把温度、梯度、热流、响应、舒适、效率、隔热、冷却、监测和热安全转为验证条件。",
    "architecture": "沿热源、传热路径、散热器、控制、传感、隔热、结构和环境接口展开。",
    "verification": "结合热网络、CFD/数值模型、样机、环境试验、传感数据和事件记录建立证据。",
    "safety": "考虑灼伤、热失控、材料退化、泄漏、冷却失效、热点扩展和错误处置。"
  },
  "diagram_groups": {
    "stakeholder_context": {
      "label": "利益相关方与系统边界",
      "order": 10
    },
    "scenario_flow": {
      "label": "场景、状态与流程",
      "order": 20
    },
    "functional_decomposition": {
      "label": "能力与功能分解",
      "order": 30
    },
    "logical_architecture": {
      "label": "逻辑架构与接口",
      "order": 40
    },
    "physical_architecture": {
      "label": "物理实现与部署",
      "order": 50
    },
    "traceability": {
      "label": "需求、验证与追溯",
      "order": 60
    }
  }
}

      "label": "工艺路线、工装与产线设计"
    },
    {
      "id": "prototype-pilot",
      "label": "试制、首件与过程验证"
    },
    {
      "id": "ramp-qualification",
      "label": "量产爬坡、能力确认与培训"
    },
    {
      "id": "production-control",
      "label": "生产控制、检验、维护与改进"
    },
    {
      "id": "change-reuse-disposal",
      "label": "工程变更、再制造与资产处置"
    }
  ],
  "scenario_dimensions": [
    {
      "id": "production_state",
      "label": "生产状态",
      "values": [
        "停机",
        "试制",
        "低负荷",
        "额定",
        "瓶颈",
        "换型",
        "返工"
      ]
    },
    {
      "id": "process_capability",
      "label": "过程能力",
      "values": [
        "受控",
        "波动",
        "超差",
        "待确认",
        "隔离",
        "恢复中"
      ]
    },
    {
      "id": "material_traceability",
      "label": "物料与追溯",
      "values": [
        "齐套",
        "短缺",
        "替代",
        "批次混淆",
        "追溯中断",
        "待验"
      ]
    },
    {
      "id": "equipment_state",
      "label": "设备状态",
      "values": [
        "正常",
        "点检",
        "预警",
        "故障",
        "维修",
        "备用"
      ]
    },
    {
      "id": "work_instruction",
      "label": "作业指导状态",
      "values": [
        "已批准",
        "培训中",
        "临时变更",
        "过期",
        "缺失",
        "多版本"
      ]
    },
    {
      "id": "quality_disposition",
      "label": "质量处置",
      "values": [
        "放行",
        "抽检",
        "返工",
        "报废",
        "让步接收",
        "调查中"
      ]
    }
  ],
  "coverage_rules": [
    {
      "id": "manufacturing-stakeholder-coverage",
      "source": "stakeholder_lenses",
      "priority": "high"
    },
    {
      "id": "manufacturing-lifecycle-coverage",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "production-capability-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "material-equipment-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "quality-change-traceability",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "workforce-safety",
      "source": "stakeholder_lenses",
      "priority": "medium"
    }
  ],
  "prompt_fragments": {
    "stakeholders": "识别客户、产品、生产、工艺、质量、供应链、维护、安全和监管角色及其交接。",
    "scenarios": "覆盖换型、首件、缺料、设备故障、作业指导变更、质量偏差、返工、放行和恢复。",
    "requirements": "将节拍、产能、工艺窗口、质量、追溯、可制造性、可检验性和安全写成验证条件。",
    "architecture": "关联产品结构、工艺路线、工装设备、人员、物料、质量数据和现场控制。",
    "verification": "明确首件、过程能力、检验、设备校准、培训、批次追溯和变更验证证据。",
    "improvement": "记录偏差、根因、纠正预防措施、经验反馈和跨产品复用边界。"
  },
  "diagram_groups": {
    "stakeholder_context": {
      "label": "利益相关方与系统边界",
      "order": 10
    },
    "scenario_flow": {
      "label": "场景、状态与流程",
      "order": 20
    },
    "functional_decomposition": {
      "label": "能力与功能分解",
      "order": 30
    },
    "logical_architecture": {
      "label": "逻辑架构与接口",
      "order": 40
    },
    "physical_architecture": {
      "label": "物理实现与部署",
      "order": 50
    },
    "traceability": {
      "label": "需求、验证与追溯",
      "order": 60
    }
  }
}

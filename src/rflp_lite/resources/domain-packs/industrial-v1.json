  "coverage_rules": [
    {
      "id": "industrial-stakeholder-coverage",
      "source": "stakeholder_lenses",
      "priority": "high"
    },
    {
      "id": "industrial-lifecycle-coverage",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "production-material-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "asset-quality-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "operator-maintenance-handoff",
      "source": "stakeholder_lenses",
      "priority": "high"
    },
    {
      "id": "continuity-and-recovery",
      "source": "lifecycle_phases",
      "priority": "medium"
    }
  ],
  "prompt_fragments": {
    "stakeholders": "区分业务、操作、维护、工艺、质量、安全、监管、社区和供应商的目标、授权和交接。",
    "scenarios": "覆盖开停机、换型、物料短缺、质量偏差、设备故障、人员交接、异常排放和恢复运行。",
    "requirements": "把产能、节拍、质量、可追溯、可维护、能效、人员安全和业务连续性转为验证条件。",
    "architecture": "检查设备、控制、制造执行、仓储物流、质量数据、人工操作和外部供应之间的边界。",
    "evidence": "为工艺能力、设备状态、质量判定、变更控制和异常处置定义可审计证据。",
    "safety": "同时考虑机械/电气危险、过程偏差、误操作、联锁、隔离、应急停机和恢复授权。"
  },
  "diagram_groups": {
    "stakeholder_context": {
      "label": "利益相关方与系统边界",
      "order": 10
    },
    "scenario_flow": {
      "label": "场景、状态与流程",
      "order": 20
    },
    "functional_decomposition": {
      "label": "能力与功能分解",
      "order": 30
    },
    "logical_architecture": {
      "label": "逻辑架构与接口",
      "order": 40
    },
    "physical_architecture": {
      "label": "物理实现与部署",
      "order": 50
    },
    "traceability": {
      "label": "需求、验证与追溯",
      "order": 60
    }
  }
}

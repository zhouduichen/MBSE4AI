  "coverage_rules": [
    {
      "id": "every-stakeholder",
      "source": "stakeholder_lenses",
      "priority": "high"
    },
    {
      "id": "every-lifecycle-phase",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "weather-visibility-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "medical-urgency-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "urban-connectivity-loss",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "takeoff-landing-recovery",
      "source": "scenario_dimensions",
      "priority": "high"
    }
  ],
  "prompt_fragments": {
    "stakeholders": "在医疗、航空、运营、空管、城市公共安全、公众、起降点和供应链之间建立责任与信息交接。",
    "scenarios": "组合医疗紧急程度、任务阶段、城市环境、天气、能见度、链路和系统状态，覆盖正常、异常、备降与恢复。",
    "requirements": "将医疗时效、飞行安全、城市运行、患者照护、隐私和基础设施约束转为可验证需求。",
    "architecture": "以医疗任务和城市空域为场景边界，逐层检查车辆、医疗舱、地面站、起降点、通信导航和医院接口。",
    "handoff": "明确接警、放行、起降、患者交接、返航、事件响应和数据归档的责任转移与确认条件。",
    "safety": "不得假设天气、链路、导航、能源、感知、控制和起降基础设施始终可用，必须定义降级和人工接管。"
  },
  "diagram_groups": {
    "stakeholder_context": {
      "label": "利益相关方与系统边界",
      "order": 10
    },
    "scenario_flow": {
      "label": "场景、状态与流程",
      "order": 20
    },
    "functional_decomposition": {
      "label": "能力与功能分解",
      "order": 30
    },
    "logical_architecture": {
      "label": "逻辑架构与接口",
      "order": 40
    },
    "physical_architecture": {
      "label": "物理实现与部署",
      "order": 50
    },
    "traceability": {
      "label": "需求、验证与追溯",
      "order": 60
    }
  }
}

{
  "id": "urban-medical-aam-v1",
  "version": 1,
  "display_name": "城市医疗用途飞行汽车",
  "description": "面向城市医疗空中交通的场景覆盖层；通过组合医疗、航空和工程学科包形成完整分析语境。",
  "extends": ["medical-v1", "aviation-v1"],
  "disciplines": ["mechanical-v1", "electrical-v1", "control-v1", "safety-v1"],
  "activation_terms": ["城市医疗飞行", "院前急救", "院际转运", "城市空中交通", "医疗起降点"],
  "mappings": [
    {"id": "mission", "value": "医疗任务与航空任务的联合场景"},
    {"id": "handoff", "value": "医疗交接、飞行放行与起降点协同"},
    {"id": "urban_constraints", "value": "人口密集区、城市障碍物、医院屋顶和应急空域"}
  ],
  "stable_fields": [
    "id",
    "name",
    "description",
    "source",
    "confidence",
    "status",
    "assumptions",
    "relations"
  ],
  "extensions": {
    "pack_layer": "scenario-overlay",
    "reusable": true,
    "vehicle_type": "electric_vertical_takeoff_aircraft",
    "safety_posture": "fail_safe_and_degraded_operation",
    "unknowns_are_first_class": true,
    "review_required_before_diagram": true
  },
  "core_overrides": [],
  "element_schemas": {
    "stakeholder": {
      "type": "object",
      "required": [
        "name",
        "category",
        "goals",
        "interactions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "scenario": {
      "type": "object",
      "required": [
        "name",
        "trigger",
        "expected_outcome"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcome": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "required": [
        "statement",
        "verification",
        "priority"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "must",
            "should",
            "could"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "responsibilities",
        "interfaces"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "required": [
        "name",
        "cause",
        "effect",
        "mitigations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "mitigations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "concern": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "need": {"type": "object", "required": ["name", "statement"], "properties": {"name": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "exchange_flow": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "target": {"type": "string"}}, "additionalProperties": true},
    "system_boundary": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "lifecycle_phase": {"type": "object", "required": ["name", "phase_id"], "properties": {"name": {"type": "string", "minLength": 1}, "phase_id": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "transition": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "from": {"type": "string"}, "to": {"type": "string"}}, "additionalProperties": true},
    "use_case": {"type": "object", "required": ["name", "actors", "goal"], "properties": {"name": {"type": "string", "minLength": 1}, "actors": {"type": "array", "items": {"type": "string"}}, "goal": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "operational_scenario": {"type": "object", "required": ["name", "trigger", "expected_outcome"], "properties": {"name": {"type": "string", "minLength": 1}, "trigger": {"type": "string", "minLength": 1}, "expected_outcome": {"type": "string", "minLength": 1}, "actors": {"type": "array", "items": {"type": "string"}}, "steps": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "capability": {"type": "object", "required": ["name", "outcome", "enablers"], "properties": {"name": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "enablers": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "function": {"type": "object", "required": ["name", "input", "output"], "properties": {"name": {"type": "string", "minLength": 1}, "input": {"type": "array", "items": {"type": "string"}}, "output": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "functional_flow": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "functional_scenario": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "logical_component": {"type": "object", "required": ["name", "responsibilities"], "properties": {"name": {"type": "string", "minLength": 1}, "responsibilities": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "physical_block": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "interface": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "solution_candidate": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "clarification_question": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "question": {"type": "string"}}, "additionalProperties": true},
    "environment": {"type": "object", "required": ["name", "category", "conditions"], "properties": {"name": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "conditions": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}
  },
  "stakeholder_lenses": [
    {
      "id": "medical",
      "label": "患者、家属与医疗团队"
    },
    {
      "id": "operations",
      "label": "运营、调度、飞行与维修"
    },
    {
      "id": "regulatory",
      "label": "监管、适航、空管与公共安全"
    },
    {
      "id": "public_environment",
      "label": "公众、城市环境与基础设施"
    },
    {
      "id": "supplier",
      "label": "能源、通信、导航与设备供应商"
    },
    {
      "id": "receiving-care",
      "label": "接收医院、起降点与交接方"
    }
  ],
  "lifecycle_phases": [
    {
      "id": "mission-definition",
      "label": "医疗任务与服务定义"
    },
    {
      "id": "concept",
      "label": "城市空域、车辆与利益相关方确认"
    },
    {
      "id": "system-design",
      "label": "系统、功能与架构设计"
    },
    {
      "id": "verification-certification",
      "label": "验证、确认与适航取证"
    },
    {
      "id": "operation",
      "label": "调度、飞行、医疗交接与运行"
    },
    {
      "id": "maintenance",
      "label": "维修、升级与持续适航"
    },
    {
      "id": "incident",
      "label": "事件响应、调查与改进"
    },
    {
      "id": "retirement",
      "label": "退役、电池处置与数据归档"
    }
  ],

{
  "id": "software-data-v1",
  "version": 1,
  "display_name": "软件、数据与数字服务",
  "description": "覆盖软件产品、数据平台、数字服务、信息系统和智能应用的通用 MBSE 发现指导。",
  "stable_fields": [
    "id",
    "name",
    "description",
    "source",
    "confidence",
    "status",
    "assumptions",
    "relations"
  ],
  "extensions": {
    "pack_layer": "industry",
    "reusable": true,
    "activation_terms": [
      "软件",
      "数据",
      "数字服务",
      "平台",
      "信息系统",
      "应用",
      "云"
    ],
    "unknowns_are_first_class": true,
    "review_required_before_diagram": true
  },
  "core_overrides": [],
  "element_schemas": {
    "stakeholder": {
      "type": "object",
      "required": [
        "name",
        "category",
        "goals",
        "interactions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "scenario": {
      "type": "object",
      "required": [
        "name",
        "trigger",
        "expected_outcome"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcome": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "required": [
        "statement",
        "verification",
        "priority"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "must",
            "should",
            "could"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "responsibilities",
        "interfaces"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "risk": {
      "type": "object",
      "required": [
        "name",
        "cause",
        "effect",
        "mitigations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "mitigations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "stakeholder_lenses": [
    {
      "id": "end-user-owner",
      "label": "终端用户、客户与产品负责人"
    },
    {
      "id": "development-architecture",
      "label": "开发、架构与测试团队"
    },
    {
      "id": "operations-platform",
      "label": "平台、运维、SRE 与支持人员"
    },
    {
      "id": "security-privacy",
      "label": "安全、隐私、合规与审计人员"
    },
    {
      "id": "business-community",
      "label": "业务、组织与受影响公众"
    },
    {
      "id": "data-provider",
      "label": "数据提供者、模型/服务与集成方"
    }
  ],
  "lifecycle_phases": [
    {
      "id": "problem-definition",
      "label": "问题、价值与服务目标定义"
    },
    {
      "id": "experience-architecture",
      "label": "体验、数据与系统架构设计"
    },
    {
      "id": "implementation-integration",
      "label": "实现、集成与验证"
    },
    {
      "id": "release-readiness",
      "label": "发布、迁移与使用准备"
    },
    {
      "id": "operation-observability",
      "label": "运行、监控、支持与改进"
    },
    {
      "id": "change-retirement",
      "label": "版本变更、迁移、停用与归档"
    }
  ],
  "scenario_dimensions": [
    {
      "id": "user_context",
      "label": "用户与业务上下文",
      "values": [
        "单用户",
        "协作",
        "高峰",
        "弱连接",
        "高风险",
        "多语言/无障碍"
      ]
    },
    {
      "id": "data_quality",
      "label": "数据质量",
      "values": [
        "完整",
        "延迟",
        "缺失",
        "冲突",
        "漂移",
        "敏感"
      ]
    },
    {
      "id": "service_state",
      "label": "服务状态",
      "values": [
        "正常",
        "限流",
        "降级",
        "部分不可用",
        "完全不可用",
        "恢复中"
      ]
    },
    {
      "id": "change_state",
      "label": "变更状态",
      "values": [
        "稳定",
        "开发中",
        "灰度",
        "升级",
        "回滚",
        "迁移"
      ]
    },
    {
      "id": "security_context",
      "label": "安全上下文",
      "values": [
        "常规",
        "高权限",
        "异常访问",
        "攻击疑似",
        "隔离",
        "审计中"
      ]
    },
    {
      "id": "integration_context",
      "label": "集成环境",
      "values": [
        "独立",
        "内部接口",
        "外部接口",
        "第三方变更",
        "协议不一致",
        "离线交换"
      ]
    }
  ],
  "coverage_rules": [
    {
      "id": "software-stakeholder-coverage",
      "source": "stakeholder_lenses",
      "priority": "high"
    },
    {
      "id": "software-lifecycle-coverage",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "data-quality-service-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "change-recovery-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "security-privacy-evidence",
      "source": "stakeholder_lenses",
      "priority": "high"
    },
    {
      "id": "integration-and-operability",
      "source": "lifecycle_phases",
      "priority": "medium"
    }
  ],
  "prompt_fragments": {
    "stakeholders": "区分用户、产品、研发、运维、安全、隐私、业务、数据提供者和外部集成方的目标与责任。",
    "scenarios": "覆盖首次使用、正常操作、高峰、数据缺失、接口异常、服务降级、攻击疑似、回滚和恢复。",
    "requirements": "将用户价值、功能、性能、可靠性、可观测性、可维护性、隐私和安全需求写成可验证条件。",
    "architecture": "从用户旅程、领域能力、数据流、接口、部署单元和运行边界逐层展开，不跳过系统上下文。",
    "data": "说明数据来源、质量、语义、权限、保留、血缘、模型/规则假设和人工复核点。",
    "delivery": "检查测试、发布、迁移、兼容、灰度、回滚、监控告警、支持流程和停用归档。"
  },
  "diagram_groups": {
    "stakeholder_context": {
      "label": "利益相关方与系统边界",
      "order": 10
    },
    "scenario_flow": {
      "label": "场景、状态与流程",
      "order": 20
    },
    "functional_decomposition": {
      "label": "能力与功能分解",
      "order": 30
    },
    "logical_architecture": {
      "label": "逻辑架构与接口",
      "order": 40
    },
    "physical_architecture": {
      "label": "物理实现与部署",
      "order": 50
    },
    "traceability": {
      "label": "需求、验证与追溯",
      "order": 60
    }
  }
}

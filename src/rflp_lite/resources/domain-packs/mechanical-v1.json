        "磨损",
        "松脱风险",
        "不可用"
      ]
    },
    {
      "id": "tolerance_state",
      "label": "公差与变形",
      "values": [
        "受控",
        "累积",
        "热变形",
        "磨损",
        "超差",
        "待判定"
      ]
    },
    {
      "id": "failure_recovery",
      "label": "故障与恢复",
      "values": [
        "正常",
        "预警",
        "降级",
        "断裂/卡滞",
        "隔离",
        "更换修复"
      ]
    }
  ],
  "coverage_rules": [
    {
      "id": "mechanical-stakeholder-coverage",
      "source": "stakeholder_lenses",
      "priority": "high"
    },
    {
      "id": "mechanical-lifecycle-coverage",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "load-motion-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "environment-tolerance-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "maintenance-access",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "materials-and-human-safety",
      "source": "stakeholder_lenses",
      "priority": "medium"
    }
  ],
  "prompt_fragments": {
    "stakeholders": "识别承载、运动、装配、维修、制造、验证和使用角色，明确机械接口与责任边界。",
    "scenarios": "组合载荷、运动、环境、公差和故障状态，覆盖正常、极限、疲劳、卡滞、维修和恢复。",
    "requirements": "把强度、刚度、寿命、质量、运动、噪声、可装配、可维修和安全约束转为可验证需求。",
    "architecture": "从功能承载链到机构、结构、连接、封装和维护接口展开，记录假设与尺寸/材料依据。",
    "verification": "明确计算、仿真、样机、试验、检查和现场数据分别验证哪些特性。",
    "safety": "考虑断裂、脱落、夹伤、锐边、失稳、过载、误装和维修隔离。"
  },
  "diagram_groups": {
    "stakeholder_context": {
      "label": "利益相关方与系统边界",
      "order": 10
    },
    "scenario_flow": {
      "label": "场景、状态与流程",
      "order": 20
    },
    "functional_decomposition": {
      "label": "能力与功能分解",
      "order": 30
    },
    "logical_architecture": {
      "label": "逻辑架构与接口",
      "order": 40
    },
    "physical_architecture": {
      "label": "物理实现与部署",
      "order": 50
    },
    "traceability": {
      "label": "需求、验证与追溯",
      "order": 60
    }
  }
}

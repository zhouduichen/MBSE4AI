    },
    {
      "id": "detail-design",
      "label": "详细设计、公差与材料选择"
    },
    {
      "id": "prototype-test",
      "label": "样机、试验与设计验证"
    },
    {
      "id": "production-service",
      "label": "制造、装配、维修与现场服务"
    },
    {
      "id": "life-end",
      "label": "升级、失效分析与拆解处置"
    }
  ],
  "scenario_dimensions": [
    {
      "id": "load_case",
      "label": "载荷工况",
      "values": [
        "静载",
        "循环",
        "冲击",
        "振动",
        "疲劳",
        "偶发极限"
      ]
    },
    {
      "id": "motion_state",
      "label": "运动状态",
      "values": [
        "静止",
        "定位",
        "连续运动",
        "往复",
        "高速",
        "卡滞/失控"
      ]
    },
    {
      "id": "environment",
      "label": "机械环境",
      "values": [
        "常温干燥",
        "潮湿",
        "腐蚀",
        "粉尘",
        "高低温",
        "冲击振动"
      ]
    },
    {
      "id": "interface_condition",
      "label": "接口条件",
      "values": [
        "名义",

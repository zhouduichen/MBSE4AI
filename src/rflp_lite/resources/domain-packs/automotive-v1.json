  "coverage_rules": [
    {
      "id": "automotive-stakeholder-coverage",
      "source": "stakeholder_lenses",
      "priority": "high"
    },
    {
      "id": "automotive-lifecycle-coverage",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "road-mode-weather-cross",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "connectivity-degradation",
      "source": "scenario_dimensions",
      "priority": "high"
    },
    {
      "id": "maintenance-and-update",
      "source": "lifecycle_phases",
      "priority": "high"
    },
    {
      "id": "vulnerable-road-users",
      "source": "stakeholder_lenses",
      "priority": "medium"
    }
  ],
  "prompt_fragments": {
    "stakeholders": "识别驾驶员、乘员、车队、维修、道路管理、其他道路参与者、监管、保险和供应链角色。",
    "scenarios": "覆盖出发、行驶、停车、充换能、故障、碰撞、接管、救援、更新和恢复场景，说明道路与用户上下文。",
    "requirements": "把出行目标转成可验证的安全、性能、舒适、可维护、网络安全和法规需求。",
    "architecture": "区分车辆本体、感知决策控制、能源、通信、云服务、道路基础设施和人工运营边界。",
    "diagnostics": "检查健康监测、故障诊断、维修授权、事件记录、远程更新和回滚路径。",
    "safety": "分析误操作、自动化边界、弱势道路参与者、通信/定位异常、动力和制动失效及事故后的安全状态。"
  },
  "diagram_groups": {
    "stakeholder_context": {
      "label": "利益相关方与系统边界",
      "order": 10
    },
    "scenario_flow": {
      "label": "场景、状态与流程",
      "order": 20
    },
    "functional_decomposition": {
      "label": "能力与功能分解",
      "order": 30
    },
    "logical_architecture": {
      "label": "逻辑架构与接口",
      "order": 40
    },
    "physical_architecture": {
      "label": "物理实现与部署",
      "order": 50
    },
    "traceability": {
      "label": "需求、验证与追溯",
      "order": 60
    }
  }
}

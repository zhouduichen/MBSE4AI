  "prompt_fragments": {
    "stakeholders": "识别供电、电子、控制、操作、维护、合规和供应角色，明确接口所有者与授权。",
    "scenarios": "覆盖上电、稳态、峰值、掉电、保护动作、信号异常、维修隔离、复电和恢复。",
    "requirements": "把功率、能效、信号完整性、时序、保护、EMC、可测试和可维护要求写成验证条件。",
    "architecture": "逐层描述能源源、变换、配电、负载、信号、接地、屏蔽和外部接口。",
    "verification": "结合计算、仿真、台架、环境、EMC、绝缘、保护动作和现场测试定义证据。",
    "safety": "考虑触电、短路、过流、热失控、误接线、残余能量、接地故障和带电维护。"
  },
  "diagram_groups": {
    "stakeholder_context": {
      "label": "利益相关方与系统边界",

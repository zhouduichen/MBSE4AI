    },
    "scenario_flow": {
      "label": "场景、状态与流程",
      "order": 20
    },
    "functional_decomposition": {
      "label": "能力与功能分解",
      "order": 30
    },
    "logical_architecture": {
      "label": "逻辑架构与接口",
      "order": 40
    },
    "physical_architecture": {
      "label": "物理实现与部署",
      "order": 50
    },
    "traceability": {
      "label": "需求、验证与追溯",
      "order": 60
    }
  }

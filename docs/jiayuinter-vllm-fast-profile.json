{
  "id": "jiayuinter-vllm-fast",
  "label": "Jiayu-intern vLLM（实验快速档）",
  "kind": "local",
  "model_location": "remote",
  "provider": "openai-compatible",
  "base_url": "http://127.0.0.1:18000/v1",
  "model": "qwen3.5-controller",
  "timeout_seconds": 30,
  "context_window": 16384,
  "max_output_tokens": 256,
  "temperature": 0.0,
  "reasoning_effort": "none",
  "think": false,
  "chat_template_kwargs": {"enable_thinking": false},
  "vertical_feedback": false,
  "automatic_operational_completion": false,
  "vertical_completion_bridge": true,
  "vertical_batch_size": 1,
  "vertical_functional_batch_size": 1,
  "vertical_logical_batch_size": 1,
  "vertical_physical_batch_size": 1,
  "vertical_vv_batch_size": 1,
  "vertical_batch_output_tokens": 256,
  "max_parallel_requests": 1,
  "structured_output_mode": "none",
  "include_response_schema_in_prompt": false,
  "remote_fail_fast": true,
  "active": false
}

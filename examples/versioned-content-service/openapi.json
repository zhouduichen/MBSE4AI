{
  "openapi": "3.0.3",
  "info": {
    "title": "Versioned Content Service",
    "version": "1.0.0"
  },
  "paths": {
    "/versions": {
      "get": {
        "operationId": "listVersions",
        "responses": {"200": {"description": "Version list"}}
      },
      "post": {
        "operationId": "saveVersion",
        "responses": {"201": {"description": "Version saved"}}
      }
    },
    "/versions/{versionId}/restore": {
      "post": {
        "operationId": "restoreVersion",
        "parameters": [
          {"name": "versionId", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Version restored"}}
      }
    }
  }
}


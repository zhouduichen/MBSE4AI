{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rflp-lite.local/schemas/run-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "python", "platform", "dependencies", "fixture_hashes", "stage_hashes", "baseline_hash", "result_hash", "status"],
  "properties": {
    "profile": {"type": "object"},
    "python": {"type": "string"},
    "platform": {"type": "string"},
    "dependencies": {"type": "object"},
    "fixture_hashes": {"type": "object"},
    "stage_hashes": {"type": "object"},
    "baseline_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["passed", "failed"]}
  }
}
